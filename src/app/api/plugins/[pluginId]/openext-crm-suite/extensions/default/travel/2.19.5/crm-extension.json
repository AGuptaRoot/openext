{
  "manifestVersion": 2,
  "id": "travel",
  "name": "Travel Agency",
  "tagline": "Travel enquiries, travellers and service requirements",
  "description": "Turns Root CRM into a travel-agency CRM: travel enquiries with traveller counts, route and dates on every lead, a configurable Travel Requirement form per service (hotel, flights, transport, excursion, package…), a Services & Forms module with a form builder, and travel locations in Settings → Travel.",
  "icon": "plane",
  "accent": "blue",
  "version": "2.19.5",
  "publisher": {
    "name": "OpenNext",
    "contact": "support@opennext.example"
  },
  "compatibility": {
    "crm": ">=3.40.0 <4.0.0"
  },
  "capabilities": [
    "declarations.fields",
    "declarations.tabs",
    "declarations.catalog",
    "declarations.settings",
    "declarations.navigation",
    "ui.mount",
    "api.models",
    "api.routes",
    "files.private",
    "ai.vision",
    "documents.pdf",
    "declarations.actions",
    "declarations.reports",
    "declarations.dashboard"
  ],
  "entry": {
    "ui": "ui/mount.js",
    "styles": "ui/style.css"
  },
  "declarations": {
    "fields": "json/fields.json",
    "tabs": "json/tabs.json",
    "catalog": "json/catalog.json",
    "settings": "json/settings.json",
    "navigation": "json/navigation.json",
    "actions": "json/actions.json",
    "reports": "json/reports.json",
    "dashboard": "json/dashboard.json"
  },
  "permissions": {
    "uses": [
      "crm.leads.read",
      "crm.leads.write",
      "crm.settings.manage",
      "crm.finance.read",
      "crm.opportunities.read",
      "crm.contacts.read"
    ],
    "defines": [
      {
        "key": "x.travel.bookings.read",
        "label": "View bookings",
        "description": "See bookings, booking services, confirmations, vouchers and provider documents.",
        "grantedWith": "crm.leads.read"
      },
      {
        "key": "x.travel.bookings.write",
        "label": "Manage bookings",
        "description": "Create bookings from accepted quotations, choose travellers, request / confirm / cancel services, cancel or complete bookings.",
        "grantedWith": "crm.leads.write"
      },
      {
        "key": "x.travel.vouchers.issue",
        "label": "Issue vouchers",
        "description": "Issue, reissue, mark sent / used and cancel service vouchers.",
        "grantedWith": "crm.leads.write"
      }
    ]
  },
  "requestTypeKey": "travel_enquiry",
  "requestTypeName": "Travel Enquiry",
  "pipelineKey": "travel_pipeline",
  "pipelineName": "Travel Sales Pipeline",
  "pipelineDescription": "Enquiry → Requirements → Quotation → Itinerary → Booking confirmed.",
  "pipelineStages": [
    {
      "id": "travel_enquiry",
      "label": "Enquiry Received",
      "type": "OPEN",
      "probability": 15
    },
    {
      "id": "travel_requirements",
      "label": "Requirements Gathered",
      "type": "OPEN",
      "probability": 30
    },
    {
      "id": "travel_quote_sent",
      "label": "Quotation Sent",
      "type": "QUOTATION_SENT",
      "probability": 70
    },
    {
      "id": "travel_itinerary_proposed",
      "label": "Itinerary Proposed",
      "type": "OPEN",
      "probability": 78
    },
    {
      "id": "travel_negotiation",
      "label": "Negotiation / Revision",
      "type": "NEGOTIATION",
      "probability": 85
    },
    {
      "id": "travel_booking_confirmed",
      "label": "Booking Confirmed",
      "type": "WON",
      "probability": 100
    },
    {
      "id": "travel_cancelled",
      "label": "Cancelled / Lost",
      "type": "LOST",
      "probability": 0
    }
  ],
  "hiddenModules": [
    "sales-orders",
    "samples",
    "projects",
    "tasks",
    "time-logs",
    "payments",
    "tickets"
  ],
  "conversions": {
    "salesOrder": false,
    "invoice": true
  },
  "highlights": [
    "Travel requirements per service, built in Services & Forms",
    "Travellers with passport and Aadhaar OCR, encrypted documents",
    "Bookings from accepted quotations; confirm every service with a reference or evidence",
    "Hotel, transport and excursion vouchers as PDF, versioned and shareable",
    "Day-by-day itinerary generated from the quotation",
    "Travel Reports: enquiries to trips, revenue and collections, services, destinations, upcoming trips and traveller readiness"
  ],
  "leadWorkflow": {
    "readinessRoute": "/lead-readiness",
    "replacesCommercialRequirement": true,
    "valuesCheckRoute": "/lead-values-check"
  },
  "salesFlow": {
    "opportunityPrefillRoute": "/opportunity-prefill",
    "quotationPrefillRoute": "/quotation-prefill",
    "hideOpportunityLines": true,
    "lockQuotationLines": true,
    "requireOpportunityForQuotation": true,
    "quotationPageTitle": "New Travel Quotation",
    "quotationPageSubtitle": "Create a quotation from travel lead requirements and opportunity details.",
    "quotationSummaryTitle": "Travel Summary",
    "quotationLinesTitle": "Travel Services / Requirements",
    "quotationLinesSubtitle": "Services from the lead’s travel requirements. Enter the rate and tax; to change route, dates or class, edit the Travel Requirement.",
    "quotationAddLineLabel": "Add Travel Line",
    "quotationLineFields": [
      {
        "key": "availability",
        "label": "Availability",
        "type": "select",
        "options": [
          "Available",
          "Held",
          "On Request"
        ],
        "tones": {
          "Available": "success",
          "Held": "info",
          "On Request": "warning"
        },
        "print": true
      },
      {
        "key": "provider",
        "label": "Provider",
        "type": "text",
        "maxLength": 120,
        "print": false
      },
      {
        "key": "service_date",
        "label": "Date",
        "type": "text",
        "maxLength": 40,
        "print": true
      },
      {
        "key": "route",
        "label": "Route",
        "type": "text",
        "maxLength": 80,
        "print": true
      },
      {
        "key": "cabin_class",
        "label": "Cabin class",
        "type": "text",
        "maxLength": 40,
        "print": true
      },
      {
        "key": "room_type",
        "label": "Room type",
        "type": "text",
        "maxLength": 60,
        "print": true
      },
      {
        "key": "meal_plan",
        "label": "Meal plan",
        "type": "text",
        "maxLength": 40,
        "print": true
      }
    ],
    "opportunityForm": {
      "title": "New Trip Opportunity",
      "subtitle": "Trip details, travellers and budget for this travel enquiry. Most of it comes from the lead.",
      "linkTypes": [
        "lead",
        "client"
      ],
      "leadOnlySetting": "opportunity_lead_only",
      "needsLead": true,
      "emptyText": "Select a lead to fill trip details",
      "savedRoute": "/sales-flow/opportunity-saved",
      "startStage": {
        "stage": "travel_enquiry",
        "readyStage": "travel_requirements"
      }
    },
    "quotationForm": {
      "emptyText": "Select a lead and its trip opportunity to fill the quotation",
      "savedRoute": "/sales-flow/quotation-saved",
      "acceptedRoute": "/sales-flow/quotation-accepted",
      "totalPer": {
        "label": "Price per person",
        "countField": "travellers",
        "showSetting": "show_price_per_person"
      },
      "paidRoute": "/sales-flow/quotation-paid"
    },
    "quotationLineGroups": [
      {
        "key": "flights",
        "title": "Flights",
        "fields": [
          "availability",
          "service_date",
          "route",
          "cabin_class",
          "provider"
        ],
        "icon": "flight"
      },
      {
        "key": "hotel",
        "title": "Hotel",
        "fields": [
          "availability",
          "service_date",
          "room_type",
          "meal_plan",
          "provider"
        ],
        "icon": "hotel"
      },
      {
        "key": "transfers",
        "title": "Transfers",
        "fields": [
          "availability",
          "service_date",
          "provider"
        ],
        "icon": "car"
      },
      {
        "key": "activities",
        "title": "Activities",
        "fields": [
          "availability",
          "service_date",
          "provider"
        ],
        "icon": "activity"
      },
      {
        "key": "visa",
        "title": "Visa",
        "fields": [
          "availability",
          "service_date",
          "provider"
        ],
        "icon": "document"
      },
      {
        "key": "insurance",
        "title": "Insurance",
        "fields": [
          "availability",
          "service_date",
          "provider"
        ],
        "icon": "shield"
      },
      {
        "key": "other",
        "title": "Other",
        "fields": [
          "availability",
          "service_date",
          "provider"
        ],
        "icon": "service"
      }
    ],
    "fixedLines": true,
    "hideQuotationSections": true,
    "requirementLink": {
      "label": "Edit Travel Requirement",
      "leadTab": "travel-requirement"
    },
    "terms": {
      "lines": "Travel Services",
      "line": "Travel Service",
      "proposedLines": "Proposed Travel Services",
      "subtotal": "Service Subtotal",
      "commercialSummary": "Commercial Summary"
    },
    "hideShipping": true,
    "lockOpportunityContact": true,
    "invoicePrefillRoute": "/sales-flow/invoice-prefill",
    "invoicePrint": {
      "layout": "service",
      "summaryTitle": "Travel Summary",
      "linesTitle": "Travel Services",
      "footer": "Thank you for travelling with us."
    },
    "invoiceFromQuotation": true,
    "hideRecurringInvoices": true,
    "hideInvoiceTemplates": true,
    "hideInvoiceWriteOff": true,
    "lockOpportunityOnAccept": true,
    "lockConvertedLead": true,
    "completeOpportunitiesOnConversion": true,
    "clientQuotationStartsWithLead": true,
    "bookingAfterAdvance": true,
    "quotationDatesRoute": "/sales-flow/quotation-dates",
    "lockWonLead": true,
    "clientQuotation": {
      "eligibleRoute": "/clients/quotation-ready",
      "pickerRoute": "/clients/:client_id/quotation-travellers",
      "startRoute": "/clients/:client_id/quotation-start",
      "notEligibleText": "Only clients with a completed Travel Requirement can get a travel quotation. Open the client → Travel Requirement first."
    }
  },
  "schedules": [
    {
      "route": "/passport-alerts/sweep",
      "every": "daily"
    }
  ]
}

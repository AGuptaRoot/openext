{
  "routes": [
    {
      "method": "GET",
      "path": "/services",
      "permission": "crm.leads.read",
      "handler": "routes/services.js#list",
      "summary": "Travel services and their requirement forms"
    },
    {
      "method": "PUT",
      "path": "/services",
      "permission": "crm.settings.manage",
      "handler": "routes/services.js#save",
      "summary": "Check and save travel services and their forms"
    },
    {
      "method": "GET",
      "path": "/leads/:lead_id/requirements",
      "permission": "crm.leads.read",
      "handler": "routes/requirements.js#listForLead",
      "summary": "Selected services, forms and saved requirements of a lead"
    },
    {
      "method": "PUT",
      "path": "/leads/:lead_id/requirements/:service_key",
      "permission": "crm.leads.write",
      "handler": "routes/requirements.js#saveForLead",
      "summary": "Check and save one service's requirement for a lead"
    },
    {
      "method": "DELETE",
      "path": "/leads/:lead_id/requirements/:service_key",
      "permission": "crm.leads.write",
      "handler": "routes/requirements.js#removeForLead",
      "summary": "Old route: soft-remove the first requirement of a service from a lead"
    },
    {
      "method": "POST",
      "path": "/leads/:lead_id/requirements",
      "permission": "crm.leads.write",
      "handler": "routes/requirements.js#createForLead",
      "summary": "Add a requirement of a service to a lead (next instance, e.g. a second hotel)"
    },
    {
      "method": "PUT",
      "path": "/requirements/:id",
      "permission": "crm.leads.write",
      "handler": "routes/requirements.js#updateById",
      "summary": "Check and save one requirement (label and values)"
    },
    {
      "method": "DELETE",
      "path": "/requirements/:id",
      "permission": "crm.leads.write",
      "handler": "routes/requirements.js#removeById",
      "summary": "Remove one requirement (kept, marked removed); refused while it is on a booking"
    },
    {
      "method": "GET",
      "path": "/requirements/:id/availability",
      "permission": "crm.leads.read",
      "handler": "routes/availability.js#list",
      "summary": "Availability checks of a requirement, newest first (prices only with finance read)"
    },
    {
      "method": "POST",
      "path": "/requirements/:id/availability",
      "permission": "crm.leads.write",
      "handler": "routes/availability.js#create",
      "summary": "Record an availability check for a Complete requirement (optional evidence file)"
    },
    {
      "method": "PUT",
      "path": "/availability/:id",
      "permission": "crm.leads.write",
      "handler": "routes/availability.js#update",
      "summary": "Correct an availability check (its author, within 15 minutes)"
    },
    {
      "method": "GET",
      "path": "/availability/:id/evidence",
      "permission": "crm.leads.read",
      "handler": "routes/availability.js#evidence",
      "summary": "Evidence file of an availability check (logged)"
    },
    {
      "method": "GET",
      "path": "/providers",
      "permission": "crm.leads.read",
      "handler": "routes/availability.js#providers",
      "summary": "Providers named in earlier availability checks (at most 20) for suggestions"
    },
    {
      "method": "GET",
      "path": "/travellers/summary",
      "permission": "crm.leads.read",
      "handler": "routes/traveller-tools.js#summary",
      "summary": "Traveller metrics: totals, age categories, passport status"
    },
    {
      "method": "GET",
      "path": "/travellers/export",
      "permission": "crm.leads.read",
      "handler": "routes/traveller-tools.js#exportCsv",
      "summary": "Travellers as CSV (document numbers masked) — logged",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/travellers/search",
      "permission": "crm.leads.write",
      "handler": "routes/traveller-tools.js#search",
      "summary": "Add existing traveller: people matching a name or phone (at most 20, numbers masked)"
    },
    {
      "method": "GET",
      "path": "/travellers",
      "permission": "crm.leads.read",
      "handler": "routes/traveller-tools.js#listAll",
      "summary": "Traveller directory: one row per person (numbers masked), search, category filter, cursor paging"
    },
    {
      "method": "GET",
      "path": "/lead-options",
      "permission": "crm.leads.write",
      "handler": "routes/traveller-tools.js#leadOptions",
      "summary": "Leads to add a traveller to: only leads with a Complete travel requirement"
    },
    {
      "method": "GET",
      "path": "/leads/:lead_id/contacts",
      "permission": "crm.leads.write",
      "handler": "routes/traveller-tools.js#leadContacts",
      "summary": "Contact people of a lead, to pick the traveller contact"
    },
    {
      "method": "GET",
      "path": "/contacts/:contact_id/travellers",
      "permission": "crm.leads.read",
      "handler": "routes/traveller-tools.js#contactTravellers",
      "summary": "Travellers whose contact person is this contact"
    },
    {
      "method": "GET",
      "path": "/travellers/:traveller_id/detail",
      "permission": "crm.leads.read",
      "handler": "routes/traveller-tools.js#detail",
      "summary": "One traveller with lead, contact person and trips (numbers masked) — logged"
    },
    {
      "method": "GET",
      "path": "/travellers/:traveller_id/trips",
      "permission": "crm.leads.read",
      "handler": "routes/traveller-tools.js#trips",
      "summary": "Travel history of the person: every lead / booking of the same profile, newest first"
    },
    {
      "method": "GET",
      "path": "/leads/:lead_id/travellers",
      "permission": "crm.leads.read",
      "handler": "routes/travellers.js#listForLead",
      "summary": "Travellers of a lead (numbers masked) with Adult / Child / Infant counts and the passport rule"
    },
    {
      "method": "POST",
      "path": "/leads/:lead_id/travellers/copy",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#copy",
      "summary": "Add an existing traveller to a lead: links the same profile (numbers stay encrypted; photos shared, not copied)"
    },
    {
      "method": "POST",
      "path": "/leads/:lead_id/travellers",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#create",
      "summary": "Check and add a traveller"
    },
    {
      "method": "POST",
      "path": "/travellers/duplicates-check",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#duplicatesCheck",
      "summary": "Traveller form: which email / phone / Aadhaar / passport another person already has (add form: who, masked; never a full number)"
    },
    {
      "method": "GET",
      "path": "/travellers/:traveller_id",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#getOne",
      "summary": "One traveller with full document numbers, for the edit form (logged)"
    },
    {
      "method": "PUT",
      "path": "/travellers/:traveller_id",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#update",
      "summary": "Check and change a traveller"
    },
    {
      "method": "DELETE",
      "path": "/travellers/:traveller_id",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#remove",
      "summary": "Delete a traveller and their document photos"
    },
    {
      "method": "PUT",
      "path": "/travellers/:traveller_id/documents/:kind",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#putDocument",
      "summary": "Store or replace the passport / Aadhaar photo (encrypted)"
    },
    {
      "method": "GET",
      "path": "/travellers/:traveller_id/documents/:kind",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#getDocument",
      "summary": "The passport / Aadhaar photo (logged; edit permission, it shows the full number)"
    },
    {
      "method": "DELETE",
      "path": "/travellers/:traveller_id/documents/:kind",
      "permission": "crm.leads.write",
      "handler": "routes/travellers.js#removeDocument",
      "summary": "Delete the passport / Aadhaar photo"
    },
    {
      "method": "GET",
      "path": "/admin/orphaned-travellers",
      "permission": "crm.settings.manage",
      "handler": "routes/traveller-tools.js#orphans",
      "summary": "Travellers whose lead no longer exists (Settings -> Travel)"
    },
    {
      "method": "POST",
      "path": "/admin/orphaned-travellers/cleanup",
      "permission": "crm.settings.manage",
      "handler": "routes/traveller-tools.js#cleanupOrphans",
      "summary": "Delete travellers of deleted leads and their document photos (audited)",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/ocr/:kind",
      "permission": "crm.leads.write",
      "handler": "routes/ocr.js#extract",
      "summary": "Read a passport / Aadhaar photo with OCR for review (nothing is saved)",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/lead-readiness",
      "permission": "crm.leads.read",
      "handler": "routes/workflow.js#readiness",
      "summary": "Lead workflow: which leads are ready (all required services Complete and enough travellers)"
    },
    {
      "method": "POST",
      "path": "/lead-values-check",
      "permission": "crm.leads.read",
      "handler": "routes/dates.js#leadValuesCheck",
      "summary": "Lead workflow: refuse travel dates in the past or that live Travel Requirements no longer fit"
    },
    {
      "method": "POST",
      "path": "/sales-flow/quotation-dates",
      "permission": "crm.leads.read",
      "handler": "routes/dates.js#quotationDates",
      "summary": "Sales flow: Issue Date not before today, Valid Till not after the Travel Start Date"
    },
    {
      "method": "POST",
      "path": "/opportunity-prefill",
      "permission": "crm.leads.read",
      "handler": "routes/sales.js#opportunity",
      "summary": "Sales flow: what a new opportunity starts with, from the lead travel data"
    },
    {
      "method": "POST",
      "path": "/quotation-prefill",
      "permission": "crm.leads.read",
      "handler": "routes/sales.js#quotation",
      "summary": "Sales flow: priced lines, sections and warnings for a new quotation"
    },
    {
      "method": "POST",
      "path": "/sales-flow/opportunity-saved",
      "permission": "crm.opportunities.read",
      "handler": "routes/sales.js#opportunitySaved",
      "summary": "Sales flow: after the CRM saved an opportunity, keep its trip plan (TripPlan) in step"
    },
    {
      "method": "POST",
      "path": "/sales-flow/quotation-saved",
      "permission": "crm.finance.read",
      "handler": "routes/sales.js#quotationSaved",
      "summary": "Sales flow: after the CRM saved a quotation, keep its travel details (QuotationTravel) in step"
    },
    {
      "method": "POST",
      "path": "/sales-flow/quotation-accepted",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#quotationAccepted",
      "summary": "Sales flow: after the CRM accepted a quotation, make its booking (setting auto_create_booking_on_accept)",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/sales-flow/quotation-paid",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#quotationPaid",
      "summary": "Sales flow: after a verified payment, make the booking once the payment rule allows it",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/bookings/for-invoice",
      "permission": "x.travel.bookings.read",
      "handler": "routes/bookings.js#forInvoice",
      "summary": "Record action \"Open Booking\" on an invoice: the booking of its quotation"
    },
    {
      "method": "POST",
      "path": "/bookings/from-quotation",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#fromQuotation",
      "summary": "Record action: create the booking of an accepted quotation (one service per line; a half-made booking is completed)",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/dashboard/overview",
      "permission": "crm.leads.read",
      "handler": "routes/dashboard.js#overview",
      "summary": "Travel Dashboard: KPIs, action required, upcoming trips, pipeline, payments, booking attention, recent activity",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/reports/options",
      "permission": "crm.leads.read",
      "handler": "routes/reports.js#options",
      "summary": "Travel Reports: filter options (destinations, travel services, booking statuses)"
    },
    {
      "method": "GET",
      "path": "/reports/sales",
      "permission": "crm.leads.read",
      "handler": "routes/reports.js#sales",
      "summary": "Travel Reports: KPIs, funnel, revenue, payment status, services, destinations, people, sources, quotations",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/reports/operations",
      "permission": "x.travel.bookings.read",
      "handler": "routes/reports.js#operations",
      "summary": "Travel Reports: bookings, upcoming trips, service confirmation, traveller readiness",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/bookings",
      "permission": "x.travel.bookings.read",
      "handler": "routes/bookings.js#list",
      "summary": "Bookings: status / search / travel date filters, counts by status, cursor paging"
    },
    {
      "method": "GET",
      "path": "/bookings/:id",
      "permission": "x.travel.bookings.read",
      "handler": "routes/bookings.js#getOne",
      "summary": "One booking: travellers (numbers masked), services with history and vouchers, itineraries"
    },
    {
      "method": "GET",
      "path": "/bookings/:id/traveller-options",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#travellerOptions",
      "summary": "Travellers that can go on a booking: the lead's and the contact's other trips (numbers masked)"
    },
    {
      "method": "PUT",
      "path": "/bookings/:id",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#update",
      "summary": "Change a booking's notes, travellers or travel dates"
    },
    {
      "method": "POST",
      "path": "/bookings/:id/cancel",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#cancel",
      "summary": "Cancel a booking (reason required): its services and live vouchers are cancelled",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/bookings/:id/complete",
      "permission": "x.travel.bookings.write",
      "handler": "routes/bookings.js#complete",
      "summary": "Mark a Confirmed booking completed once the trip has ended"
    },
    {
      "method": "GET",
      "path": "/leads/:lead_id/bookings",
      "permission": "x.travel.bookings.read",
      "handler": "routes/bookings.js#forLead",
      "summary": "Bookings and itineraries of a lead"
    },
    {
      "method": "GET",
      "path": "/clients/:client_id/travel-requirement",
      "permission": "crm.leads.read",
      "handler": "routes/client-requirement.js#getForClient",
      "summary": "Client → Travel Requirement: the client's open travel enquiry, its Travel Information and requirement forms"
    },
    {
      "method": "PUT",
      "path": "/clients/:client_id/travel-requirement",
      "permission": "crm.leads.write",
      "handler": "routes/client-requirement.js#saveForClient",
      "summary": "Client → Travel Requirement: save Travel Information and every selected requirement form (no lead is created)",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/clients/:client_id/travel-requirement/lead-form-sync",
      "permission": "crm.leads.read",
      "handler": "routes/client-requirement.js#leadFormSyncStatus",
      "summary": "Lead create → existing client: may the lead form's Travel Information be copied to this client (not when its open trip has a quotation)"
    },
    {
      "method": "POST",
      "path": "/clients/:client_id/travel-requirement/lead-form-sync",
      "permission": "crm.leads.write",
      "handler": "routes/client-requirement.js#leadFormSync",
      "summary": "Lead create → existing client: copy the lead form's Travel Information (Step 1 only) to the client's Travel Requirement",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/clients/:client_id/travel-requirement/trip",
      "permission": "crm.leads.write",
      "handler": "routes/client-requirement.js#startTrip",
      "summary": "Client → Travel Requirement: open the trip (enquiry lead) from the saved requirement, to add travellers",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/clients/quotation-ready",
      "permission": "crm.leads.read",
      "handler": "routes/client-requirement.js#quotationReady",
      "summary": "Client quotation: clients whose Travel Requirement is complete",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/clients/:client_id/quotation-travellers",
      "permission": "crm.leads.read",
      "handler": "routes/client-requirement.js#quotationTravellers",
      "summary": "Client quotation: travellers to choose from (at least one)"
    },
    {
      "method": "POST",
      "path": "/clients/:client_id/quotation-start",
      "permission": "crm.leads.write",
      "handler": "routes/client-requirement.js#quotationStart",
      "summary": "Client quotation: add the chosen travellers to the enquiry and open its trip opportunity",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/clients/:client_id/travellers",
      "permission": "crm.leads.read",
      "handler": "routes/client-travellers.js#forClient",
      "summary": "Client → Travellers: every traveller of the client, also those added while it was a lead (one row per person)"
    },
    {
      "method": "POST",
      "path": "/passport-alerts/sweep",
      "permission": "crm.leads.read",
      "handler": "routes/client-travellers.js#sweep",
      "summary": "Daily job: Passport Expiry Alert for passports entering the 6-month window (once per traveller and date)",
      "timeoutMs": 60000
    },
    {
      "method": "GET",
      "path": "/clients/:client_id/bookings",
      "permission": "x.travel.bookings.read",
      "handler": "routes/bookings.js#forClient",
      "summary": "Bookings of a client, also the ones made while it was a lead or an opportunity"
    },
    {
      "method": "POST",
      "path": "/booking-services/:id/request",
      "permission": "x.travel.bookings.write",
      "handler": "routes/booking-services.js#request",
      "summary": "Mark a booking service requested from the provider"
    },
    {
      "method": "POST",
      "path": "/booking-services/:id/confirm",
      "permission": "x.travel.bookings.write",
      "handler": "routes/booking-services.js#confirm",
      "summary": "Confirm Service: provider answer with reference / evidence (history kept, booking status rolled up)"
    },
    {
      "method": "POST",
      "path": "/booking-services/:id/cancel",
      "permission": "x.travel.bookings.write",
      "handler": "routes/booking-services.js#cancel",
      "summary": "Cancel one booking service (reason required); its live vouchers are cancelled"
    },
    {
      "method": "PUT",
      "path": "/booking-services/:id/documents",
      "permission": "x.travel.bookings.write",
      "handler": "routes/booking-services.js#putDocuments",
      "summary": "Add or remove a provider document (tickets); removal is recorded in the history"
    },
    {
      "method": "GET",
      "path": "/booking-services/:id/files/:file_id",
      "permission": "x.travel.bookings.read",
      "handler": "routes/booking-services.js#getFile",
      "summary": "An evidence file or provider document of this booking service (logged)"
    },
    {
      "method": "POST",
      "path": "/booking-services/:id/vouchers",
      "permission": "x.travel.vouchers.issue",
      "handler": "routes/vouchers.js#issue",
      "summary": "Issue or reissue the voucher of a Confirmed service (PDF; the older version is superseded)",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/vouchers/:id/file",
      "permission": "x.travel.bookings.read",
      "handler": "routes/vouchers.js#getFile",
      "summary": "The voucher PDF"
    },
    {
      "method": "POST",
      "path": "/vouchers/:id/sent",
      "permission": "x.travel.vouchers.issue",
      "handler": "routes/vouchers.js#sent",
      "summary": "Mark a voucher sent (channel and recipient noted)"
    },
    {
      "method": "POST",
      "path": "/vouchers/:id/used",
      "permission": "x.travel.vouchers.issue",
      "handler": "routes/vouchers.js#used",
      "summary": "Mark a voucher used"
    },
    {
      "method": "POST",
      "path": "/vouchers/:id/cancel",
      "permission": "x.travel.vouchers.issue",
      "handler": "routes/vouchers.js#cancel",
      "summary": "Cancel a voucher (reason required); the PDF is redrawn with CANCELLED",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/itineraries/from-quotation",
      "permission": "crm.leads.write",
      "handler": "routes/itineraries.js#fromQuotation",
      "summary": "Record action: generate the itinerary of a quotation (opens its draft; replace regenerates; copy a version)",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/itineraries",
      "permission": "crm.leads.read",
      "handler": "routes/itineraries.js#list",
      "summary": "Itineraries of a quotation, lead or booking"
    },
    {
      "method": "GET",
      "path": "/itineraries/:id",
      "permission": "crm.leads.read",
      "handler": "routes/itineraries.js#getOne",
      "summary": "One itinerary with its days and the quotation's other versions"
    },
    {
      "method": "PUT",
      "path": "/itineraries/:id",
      "permission": "crm.leads.write",
      "handler": "routes/itineraries.js#update",
      "summary": "Edit a draft itinerary (days, items, notes)"
    },
    {
      "method": "POST",
      "path": "/itineraries/:id/finalize",
      "permission": "crm.leads.write",
      "handler": "routes/itineraries.js#finalize",
      "summary": "Finalize an itinerary: PDF, guest snapshot; the older final version is superseded",
      "timeoutMs": 30000
    },
    {
      "method": "GET",
      "path": "/itineraries/:id/file",
      "permission": "crm.leads.read",
      "handler": "routes/itineraries.js#getFile",
      "summary": "The itinerary PDF (logged)"
    },
    {
      "method": "GET",
      "path": "/quotations/:quotation_id/travel",
      "permission": "crm.leads.read",
      "handler": "routes/trip-views.js#quotationTravel",
      "summary": "Quotation page section: its booking and itinerary versions"
    },
    {
      "method": "GET",
      "path": "/opportunities/:opportunity_id/trip",
      "permission": "crm.leads.read",
      "handler": "routes/trip-views.js#opportunityTrip",
      "summary": "Opportunity page section: the lead's trip, services and travellers (read-only)"
    },
    {
      "method": "GET",
      "path": "/portal/bookings",
      "permission": "crm.finance.read",
      "handler": "routes/portal.js#list",
      "summary": "Client portal: the client's own bookings with payment status"
    },
    {
      "method": "GET",
      "path": "/portal/bookings/:id",
      "permission": "crm.finance.read",
      "handler": "routes/portal.js#get",
      "summary": "Client portal: one booking with services, vouchers and documents"
    },
    {
      "method": "GET",
      "path": "/portal/vouchers/:id/file",
      "permission": "crm.finance.read",
      "handler": "routes/portal.js#voucherFile",
      "summary": "Client portal: voucher PDF, only when paid in full"
    },
    {
      "method": "GET",
      "path": "/portal/booking-services/:id/files/:file_id",
      "permission": "crm.finance.read",
      "handler": "routes/portal.js#serviceFile",
      "summary": "Client portal: ticket or confirmation document, only when paid in full"
    },
    {
      "method": "GET",
      "path": "/field-suggestions",
      "permission": "crm.leads.read",
      "handler": "routes/field-suggestions.js#list",
      "summary": "Type-ahead values entered before for a requirement text field"
    },
    {
      "method": "POST",
      "path": "/field-suggestions",
      "permission": "crm.leads.write",
      "handler": "routes/field-suggestions.js#add",
      "summary": "Add a value to a requirement text field's suggestions"
    },
    {
      "method": "GET",
      "path": "/locations",
      "permission": "crm.settings.manage",
      "handler": "routes/locations.js#list",
      "summary": "Travel locations (stable ids) and the From / To lists (Settings -> Travel)"
    },
    {
      "method": "POST",
      "path": "/locations/import",
      "permission": "crm.settings.manage",
      "handler": "routes/locations.js#importRows",
      "summary": "Check (dryRun) or import From / To locations from CSV rows; lists only grow (audited)",
      "timeoutMs": 30000
    },
    {
      "method": "POST",
      "path": "/sales-flow/invoice-prefill",
      "permission": "crm.finance.read",
      "handler": "routes/sales.js#invoice",
      "summary": "Sales flow: read-only travel summary (booking, destination, dates, travellers) for the invoice page"
    }
  ]
}

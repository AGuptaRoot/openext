# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/public/upload
/public/siteicon
# Uploaded Theme Engine packages: src/themes/[slug]/{slug}/
/src/themes/[[]slug[]]/*
!/src/themes/[[]slug[]]/.gitkeep
!/src/themes/[[]slug[]]/README.md

# Extension packages uploaded at runtime (not CMS source)
/src/extension-packages/*
!/src/extension-packages/.gitkeep

# Uploaded plugin frontend: src/plugins/{pluginId}/
# /src/plugins/*
# !/src/plugins/.gitkeep
# !/src/plugins/README.md

# Uploaded plugin backend: src/app/api/plugins/[pluginId]/{pluginId}/
# /src/app/api/plugins/[[]pluginId[]]/*
# !/src/app/api/plugins/[[]pluginId[]]/[[][[[]...path[]][]]]/
# !/src/app/api/plugins/[[]pluginId[]]/data/
# !/src/app/api/plugins/[[]pluginId[]]/.gitkeep

# Legacy upload locations at project root (no longer used — uploads go under src/)
/plugins/*
!/plugins/.gitkeep
/themes/*
!/themes/.gitkeep

# Legacy — uploads must not use public/; kept only if old files remain on disk
/public/plugins/*
!/public/plugins/.gitkeep

# Layout planner training artifacts (schema + scripts + fixtures + briefs stay tracked)
training/data/raw/
training/data/validated/
training/outputs/
training/layout-planner/outputs/
# Python bytecode from the training scripts
training/**/__pycache__/
*.pyc

src/lib/plugins/__tests__/sdkReconnect.test.ts
